# Rendered by the nginx buildpack (bin/run) inside its http block, which already
# sets gzip, client_max_body_size 100m and the real client IP.

# Media stored in the database (SF_USE_DB_STORAGE): each request is a Postgres
# read, so keep a copy on the container disk. Lost on restart, refilled on demand.
# The db_storage view sends Cache-Control: public, max-age=3600, which sets the TTL.
proxy_cache_path /tmp/nginx-media levels=1:2 keys_zone=media:10m max_size=1g inactive=1d use_temp_path=off;

upstream gunicorn {
    server unix:/tmp/gunicorn.sock fail_timeout=0;
    keepalive 16;
}

server {
    listen <%= ENV["PORT"] %>;
    server_name _;

    # HTTP/1.1 + empty Connection header: required for upstream keepalive
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $http_host;
    proxy_read_timeout 120s; # gunicorn timeout: long admin operations

    # collectstatic output. ponytail: 1h, not "expires max": filenames are not
    # hashed (StaticFilesStorage), a long expiry would pin old CSS/JS after an upgrade.
    location /static/ {
        alias /app/staticfiles/;
        expires 1h;
        access_log off;
    }

    location /db-storage/ {
        proxy_pass http://gunicorn;
        proxy_cache media;
        proxy_cache_lock on;
        proxy_cache_use_stale error timeout updating;
        add_header X-Cache-Status $upstream_cache_status always;
    }

    location / {
        proxy_pass http://gunicorn;
    }
}
